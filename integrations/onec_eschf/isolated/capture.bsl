    ДоВызова = ПолучитьСообщенияПользователю(Истина);
    ИсключениеВызова = "";
    Результат = Неопределено;
    Попытка
        Результат = ПодготовитьИсходныйXMLЛокально(СсылкаНаОбъект);
    Исключение
        ИсключениеВызова = ОписаниеОшибки();
    КонецПопытки;
    ПослеВызова = ПолучитьСообщенияПользователю(Ложь);
    Захват = Новый Структура;
