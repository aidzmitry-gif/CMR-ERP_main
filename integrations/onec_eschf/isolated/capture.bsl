    Захват.Вставить("result", Результат);
    Захват.Вставить("exception", ИсключениеВызова);
    Захват.Вставить("messages_before", ТекстыИзолированныхСообщений(ДоВызова));
    Захват.Вставить("messages_after", ТекстыИзолированныхСообщений(ПослеВызова));
