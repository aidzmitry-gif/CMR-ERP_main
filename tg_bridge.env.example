# Telegram-мост (tg_bridge.py) — скопируй нужные строки в .env в корне репо.
# .env уже в .gitignore — токен в git не попадёт.

# Токен бота от @BotFather (обязательно)
TG_BOT_TOKEN=123456789:AA...your-token...

# id форум-группы (узнать: python tg_bridge.py --probe). Обычно отрицательный.
TG_CHAT_ID=-1001234567890

# (опц.) только твои user id могут командовать ботом — через запятую.
# Свой id увидишь в выводе --probe (поле from=...).
TG_ALLOWED_USER_IDS=

# (опц.) период опроса состояний воркеров, сек (деф. 8)
TG_POLL_SEC=8

# (опц.) 1 = форум-топики (топик на воркера, рекомендуется), 0 = один чат с префиксами
TG_FORUM=1

# ── Вариант B (продолжение твоих сессий Claude Code с телефона) ──
# Режим разрешений для headless-хода: acceptEdits (деф., авто-правки файлов, но
# без запуска произвольных команд) | bypassPermissions (полный автоном: pytest/git
# из телефона, но трогает рабочий репо без спроса) | default | auto.
TG_B_PERMISSION_MODE=acceptEdits
# Модель: inherit = брать модель/настройки самой сессии (рекомендуется).
TG_B_MODEL=inherit
# Верхняя граница одного хода, сек.
TG_B_TURN_TIMEOUT=1200
