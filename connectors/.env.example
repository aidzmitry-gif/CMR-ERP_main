# Скопируйте в .env и заполните своими значениями.

# Куда складывать результат
DATA_DIR=./data

# --- Bitrix24 (облако) ---
# Создайте «Входящий вебхук» в Битрикс24 и вставьте его URL целиком.
# Права вебхука: telephony, crm, user, disk.
BITRIX_WEBHOOK=https://your-portal.bitrix24.ru/rest/1/xxxxxxxxxxxxxxxx/

# --- 1C (OData) ---
# URL опубликованной стандартной службы OData и пользователь с правами на чтение.
ONEC_BASE_URL=http://1c-server/base/odata/standard.odata/
ONEC_USER=odata_user
ONEC_PASSWORD=change_me
# Состав объектов 1С задаётся в config.py (ONEC_ENTITY_SETS) — он зависит от вашей конфигурации.

# --- Google ---
# Путь к JSON-ключу сервисного аккаунта (включите Drive API, Docs API, Sheets API).
GOOGLE_CREDENTIALS_FILE=./service_account.json
# ID папок Google Drive через запятую (берётся из URL папки).
GOOGLE_FOLDER_IDS=1AbCdEf...,1GhIjKl...
# Для domain-wide delegation укажите e-mail пользователя для имперсонации (иначе оставьте пустым).
GOOGLE_IMPERSONATE=
