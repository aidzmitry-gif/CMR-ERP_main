# Скопируйте в .env и при необходимости поправьте. Префикс переменных — AIOS_.
# Этот файл читает сервис `app` в docker-compose (env_file) И интерполяция ${...} в compose.
# .env — untracked (.gitignore): прод-значения git pull НЕ перетирает.

# --- Локальный dev (по умолчанию) ---
AIOS_ENVIRONMENT=dev
AIOS_DEBUG=true
# Внутри docker compose хосты БД/Redis — это имена сервисов (postgres/redis).
# Для запуска uvicorn НА ХОСТЕ (без контейнера app) задайте localhost через $env: в шелле —
# переменная окружения перебивает .env (см. CLAUDE.md «Команды»).
AIOS_DATABASE_URL=postgresql+psycopg://aios:aios@postgres:5432/aios
AIOS_REDIS_URL=redis://redis:6379/0

# --- Прод (раскомментировать и заполнить; см. DEPLOY.md, SECURITY.md P0-4/P1-1) ---
# Без этого блока приложение в проде НЕ стартует (страховка от тихого dev-режима):
# AIOS_ENVIRONMENT=production
# AIOS_DEBUG=false
# Креды БД (одни и те же в URL приложения и в сервисах postgres/keycloak):
# AIOS_PG_USER=<user>
# AIOS_PG_PASSWORD=<СИЛЬНЫЙ_ПАРОЛЬ>
# AIOS_PG_DB=<db>
# AIOS_DATABASE_URL=postgresql+psycopg://<user>:<СИЛЬНЫЙ_ПАРОЛЬ>@postgres:5432/<db>
# Keycloak admin (вместо admin/admin):
# AIOS_KC_ADMIN_USER=<admin-user>
# AIOS_KC_ADMIN_PASSWORD=<СИЛЬНЫЙ_ПАРОЛЬ>
# Реальная аутентификация (иначе прод-гард валит старт — доверие X-User-Roles запрещено):
# AIOS_AUTH_MODE=oidc
# AIOS_KEYCLOAK_ISSUER=https://<host>/realms/<realm>
# AIOS_KEYCLOAK_AUDIENCE=<client_id>

# Рассылка перевозчикам о тендере (модуль logistics). Без настройки — MVP-лог.
# Email через SMTP — раскомментируйте и заполните:
# AIOS_SMTP_HOST=smtp.yandex.ru
# AIOS_SMTP_PORT=587
# AIOS_SMTP_USER=tender@your-company.by
# AIOS_SMTP_PASSWORD=app-password
# AIOS_SMTP_FROM=tender@your-company.by
# AIOS_SMTP_TLS=true
# Telegram Bot API (токен от @BotFather):
# AIOS_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Вебхуки внешних каналов — в проде задавать ОБЯЗАТЕЛЬНО (иначе приём открыт публично):
# AIOS_TELEPHONY_WEBHOOK_TOKEN=<длинный-случайный-секрет>   # вебхук облачной АТС zruchna
# AIOS_TELEPHONY_ORIGINATE_URL=https://call.zruchna.io/.../client_call_gen.php  # исходящий звонок
# AIOS_INTAKE_WEBHOOK_TOKEN=<длинный-случайный-секрет>      # приём лидов с сайта и почты
