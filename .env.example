# Скопируйте в .env и при необходимости поправьте. Префикс переменных — AIOS_.
AIOS_ENVIRONMENT=dev
AIOS_DEBUG=true
AIOS_DATABASE_URL=postgresql+psycopg://aios:aios@localhost:5432/aios
AIOS_REDIS_URL=redis://localhost:6379/0

# Рассылка перевозчикам о тендере (модуль logistics). Без настройки — MVP-лог.
# Email через SMTP — раскомментируйте и заполните:
# AIOS_SMTP_HOST=smtp.yandex.ru
# AIOS_SMTP_PORT=587
# AIOS_SMTP_USER=tender@your-company.by
# AIOS_SMTP_PASSWORD=app-password
# AIOS_SMTP_FROM=tender@your-company.by
# AIOS_SMTP_TLS=true
# Telegram Bot API (токен от @BotFather):
# AIOS_TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Вебхуки внешних каналов — в проде задавать ОБЯЗАТЕЛЬНО (иначе приём открыт публично):
# AIOS_TELEPHONY_WEBHOOK_TOKEN=<длинный-случайный-секрет>   # вебхук облачной АТС zruchna
# AIOS_TELEPHONY_ORIGINATE_URL=https://call.zruchna.io/.../client_call_gen.php  # исходящий звонок
# AIOS_INTAKE_WEBHOOK_TOKEN=<длинный-случайный-секрет>      # приём лидов с сайта и почты

# Single-company installation: set the real seller UNP explicitly. The legacy code default is not a binding.
# Read-only instance context resolves this UNP only among the authenticated employee's existing book grants.
AIOS_SELLER_UNP=
