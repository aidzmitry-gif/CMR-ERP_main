{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "./frontend", "run", "dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "static-mockups",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8791"],
      "port": 8791,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "-c",
        "import os; os.environ.setdefault('AIOS_DATABASE_URL', 'sqlite+aiosqlite:///./dev.db'); os.environ.setdefault('AIOS_ENVIRONMENT', 'dev'); import uvicorn; uvicorn.run('main:app', port=8000)"
      ],
      "port": 8000,
      "autoPort": true
    }
  ]
}
