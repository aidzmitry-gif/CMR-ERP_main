{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "./frontend", "run", "dev", "--", "-p", "3210"],
      "port": 3210,
      "autoPort": true
    },
    {
      "name": "static-mockups",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "8791"],
      "port": 8791,
      "autoPort": true
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["scripts/dev_backend.py"],
      "port": 8000,
      "autoPort": true
    }
  ]
}
